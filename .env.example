# Secrets
BOT_TOKEN=
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# HTTP
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
GIN_MODE=release

# Database pool
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_PING_TIMEOUT=5s

# Telegram
TELEGRAM_SUPPORT=@bazan_ivan

# Worker (Kufar poll interval)
WORKER_INTERVAL=5m

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,https://hronovv.github.io
